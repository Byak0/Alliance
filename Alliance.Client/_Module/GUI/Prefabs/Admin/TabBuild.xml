<Prefab>
	<Parameters/>
	<Constants>
		<Constant Name="DropdownHeader.Width" BrushName="MPLobby.Matchmaking.Region.DropdownHeader" BrushLayer="Default" BrushValueType="Width"/>
		<Constant Name="DropdownHeader.Height" BrushName="MPLobby.Matchmaking.Region.DropdownHeader" BrushLayer="Default" BrushValueType="Height"/>
	</Constants>
	<VisualDefinitions/>
	<Window>

		<BrushWidget IsVisible="@ShowBuildTab" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="140" MarginLeft="80" MarginRight="80" MarginBottom="100" Brush="Alliance.MainFrame">
			<Children>

				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" ExtendTop="27" ExtendLeft="26" ExtendRight="27" ExtendBottom="29" Sprite="Frame1_frame" OverlayMethod="CoverWithTexture" OverlaySprite="stone_texture_overlay" DataSource="{BuildTab}">
					<Children>

						<!-- Search -->
						<Widget WidthSizePolicy="Fixed" SuggestedWidth="320" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="20" MarginTop="10" Sprite="StdAssets\tabbar_long_namebox">
							<Children>
								<EditableTextWidget WidthSizePolicy="Fixed" SuggestedWidth="290" HeightSizePolicy="Fixed" SuggestedHeight="45" MarginLeft="15" HorizontalAlignment="Left" VerticalAlignment="Bottom" Brush="MPLobby.ClassFilter.ClassTuple.Text" Brush.FontSize="20" DefaultSearchText="Search prefab..." Text="@FilterText" />
							</Children>
						</Widget>

						<!-- Toggle enabled only -->
						<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="20" MarginTop="68" StackLayout.LayoutMethod="HorizontalLeftToRight">
							<Children>
								<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="50" VerticalAlignment="Center" Brush="Alliance.Button.Checkbox" IsSelected="@ShowOnlyEnabled" Command.Click="ToggleShowOnlyEnabled"/>
								<TextWidget SuggestedWidth="180" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" MarginLeft="10" VerticalAlignment="Center" Brush.FontSize="24" Text="Enabled only" />
							</Children>
						</ListPanel>

						<!-- Actions -->
						<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="55" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="68" MarginRight="20" StackLayout.LayoutMethod="HorizontalLeftToRight">
							<Children>
								<ButtonWidget DoNotPassEventsToChildren="true" MarginRight="10" SuggestedWidth="150" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="WideButton.Flat" UpdateChildrenStates="true" Command.Click="EnableAllVisible">
									<Children>
										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Children>
												<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginTop="10" MarginBottom="10" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" Text="Enable all" />
											</Children>
										</ListPanel>
									</Children>
								</ButtonWidget>

								<ButtonWidget DoNotPassEventsToChildren="true" MarginRight="10" SuggestedWidth="150" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="WideButton.Flat" UpdateChildrenStates="true" Command.Click="DisableAllVisible">
									<Children>
										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Children>
												<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginTop="10" MarginBottom="10" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" Text="Disable all" />
											</Children>
										</ListPanel>
									</Children>
								</ButtonWidget>
								
								<ButtonWidget DoNotPassEventsToChildren="true" MarginLeft="10" SuggestedWidth="150" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="WideButton.Flat" UpdateChildrenStates="true" Command.Click="Save">
									<Children>
										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Children>
												<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginTop="10" MarginBottom="10" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Popup.Button.Text" Text="Save" />
											</Children>
										</ListPanel>
									</Children>
								</ButtonWidget>
							</Children>
						</ListPanel>

						<!-- Status -->
						<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="126" MarginLeft="20" MarginRight="20" Brush.FontSize="22" Text="@StatusText" />

						<!-- Header -->
						<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="160">
							<Children>
								<TextWidget SuggestedWidth="96" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" VerticalAlignment="Center" Brush.FontSize="24" Text="Enabled" />
								<TextWidget SuggestedWidth="220" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="Module" />
								<TextWidget SuggestedWidth="320" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="File" />
								<TextWidget SuggestedWidth="520" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="Prefab id" />
							</Children>
						</ListPanel>

						<!-- Prefab list -->
						<ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" VerticalAlignment="Center" AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\PrefabList" VerticalScrollbar="..\VerticalScrollbar" MarginTop="182">
							<Children>
								<Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" VerticalAlignment="Center">
									<Children>
										<ListPanel Id="PrefabList" DataSource="{Prefabs}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalBottomToTop" MarginTop="20">
											<ItemTemplate>
												<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="4" Sprite="MPGeneral\MPScoreboard\player_indicator" Color="#A18661FF" AlphaFactor="0.4" IsVisible="@IsVisible">
													<Children>
														<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="96" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center">
															<Children>
																<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="50" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Alliance.Button.Checkbox" IsSelected="@IsEnabled" Command.Click="ToggleEnabled"/>
															</Children>
														</Widget>

														<TextWidget SuggestedWidth="220" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="@Module" />
														<TextWidget SuggestedWidth="320" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="@SourceFile" />
														<TextWidget SuggestedWidth="520" SuggestedHeight="30" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="24" Text="@Id" />
													</Children>
												</ListPanel>
											</ItemTemplate>
										</ListPanel>
									</Children>
								</Widget>
							</Children>
						</ScrollablePanel>

						<ScrollbarWidget Id="VerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="10" HorizontalAlignment="Right" VerticalAlignment="Center" MarginTop="0" MarginBottom="0" AlignmentAxis="Vertical" Handle="VerticalScrollbarHandle" MaxValue="100" MinValue="0">
							<Children>
								<Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#5a4033FF" />
								<ImageWidget Id="VerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
							</Children>
						</ScrollbarWidget>

						<!-- Module dropdown -->
						<NavigationScopeTargeter ScopeID="BuildModuleDropdownScope" ScopeParent="..\ModuleDropdownParent" ScopeMovements="Vertical" />
						<DirectionalListPanelDropdownWidget Id="ModuleDropdownParent"
															DataSource="{ModuleSelector}"
															WidthSizePolicy="Fixed"
															HeightSizePolicy="CoverChildren"
															SuggestedWidth="250"
															MarginLeft="360"
															MarginTop="10"
															HorizontalAlignment="Left"
															VerticalAlignment="Top"
															DoNotHandleDropdownListPanel="true"
															CurrentSelectedIndex="@SelectedIndex"
															Button="ModuleDropdownButton"
															ListPanelContainer="ModuleListContainer"
															ListPanel="ModuleListContainer\ModuleScrollablePanel\ModuleClipRect\ModuleSelectorList"
															RichTextWidget="ModuleDropdownButton\ModuleContainer\ModuleContainerChild\SelectedModuleTextWidget">
							<Children>
								<ButtonWidget Id="ModuleDropdownButton" Type="Toggle" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Left" VerticalAlignment="Top">
									<Children>
										<Widget Id="ModuleContainer" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center">
											<Children>
												<BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="Fixed" SuggestedHeight="40" Brush="MPLobby.ClassFilter.ClassTuple.Background"/>
												<ListPanel Id="ModuleContainerChild" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center">
													<Children>
														<RichTextWidget Id="SelectedModuleTextWidget" Text=" " WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="5" Brush="MPLobby.ClassFilter.ClassTuple.Text"/>
													</Children>
												</ListPanel>
											</Children>
										</Widget>
									</Children>
								</ButtonWidget>

								<BrushWidget Id="ModuleListContainer" IsVisible="false" WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="Fixed" SuggestedHeight="300" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="50" Brush="MPLobby.Popup.Frame">
									<Children>
										<ScrollablePanel Id="ModuleScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" VerticalAlignment="Center" AutoHideScrollBars="true" ClipRect="ModuleClipRect" InnerPanel="ModuleClipRect\ModuleSelectorList" VerticalScrollbar="..\ModuleVerticalScrollbar">
											<Children>
												<Widget Id="ModuleClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" VerticalAlignment="Center">
													<Children>
														<BrushListPanel Id="ModuleSelectorList" DataSource="{ItemList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop" Brush="Alliance.ListFrame">
															<ItemTemplate>
																<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" ButtonType="Radio" Brush="MPLobby.Matchmaking.Region.DropdownItem">
																	<Children>
																		<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10">
																			<Children>
																				<RichTextWidget Text="@StringItem" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="MPLobby.Matchmaking.Region.ItemText"/>
																			</Children>
																		</ListPanel>
																	</Children>
																</ButtonWidget>
															</ItemTemplate>
														</BrushListPanel>
													</Children>
												</Widget>
											</Children>
										</ScrollablePanel>
										<ScrollbarWidget Id="ModuleVerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="15" HorizontalAlignment="Right" VerticalAlignment="Center" AlignmentAxis="Vertical" Handle="ModuleVerticalScrollbarHandle" MaxValue="100" MinValue="0">
											<Children>
												<Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="6" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#5a4033FF" />
												<ImageWidget Id="ModuleVerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
											</Children>
										</ScrollbarWidget>
									</Children>
								</BrushWidget>
							</Children>
						</DirectionalListPanelDropdownWidget>

						<!-- File dropdown -->
						<NavigationScopeTargeter ScopeID="BuildFileDropdownScope" ScopeParent="..\FileDropdownParent" ScopeMovements="Vertical" />
						<DirectionalListPanelDropdownWidget Id="FileDropdownParent"
															DataSource="{FileSelector}"
															WidthSizePolicy="Fixed"
															HeightSizePolicy="CoverChildren"
															SuggestedWidth="250"
															MarginLeft="630"
															MarginTop="10"
															HorizontalAlignment="Left"
															VerticalAlignment="Top"
															DoNotHandleDropdownListPanel="true"
															CurrentSelectedIndex="@SelectedIndex"
															Button="FileDropdownButton"
															ListPanelContainer="FileListContainer"
															ListPanel="FileListContainer\FileScrollablePanel\FileClipRect\FileSelectorList"
															RichTextWidget="FileDropdownButton\FileContainer\FileContainerChild\SelectedFileTextWidget">
							<Children>
								<ButtonWidget Id="FileDropdownButton" Type="Toggle" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Left" VerticalAlignment="Top">
									<Children>
										<Widget Id="FileContainer" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center">
											<Children>
												<BrushWidget WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="Fixed" SuggestedHeight="40" Brush="MPLobby.ClassFilter.ClassTuple.Background"/>
												<ListPanel Id="FileContainerChild" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center">
													<Children>
														<RichTextWidget Id="SelectedFileTextWidget" Text=" " WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="5" Brush="MPLobby.ClassFilter.ClassTuple.Text"/>
													</Children>
												</ListPanel>
											</Children>
										</Widget>
									</Children>
								</ButtonWidget>

								<BrushWidget Id="FileListContainer" IsVisible="false" WidthSizePolicy="Fixed" SuggestedWidth="250" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="50" Brush="MPLobby.Popup.Frame">
									<Children>
										<ScrollablePanel Id="FileScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" VerticalAlignment="Center" AutoHideScrollBars="true" ClipRect="FileClipRect" InnerPanel="FileClipRect\FileSelectorList" VerticalScrollbar="..\FileVerticalScrollbar">
											<Children>
												<Widget Id="FileClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" VerticalAlignment="Center">
													<Children>
														<BrushListPanel Id="FileSelectorList" DataSource="{ItemList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalBottomToTop" Brush="Alliance.ListFrame">
															<ItemTemplate>
																<ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" ButtonType="Radio" Brush="MPLobby.Matchmaking.Region.DropdownItem">
																	<Children>
																		<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10">
																			<Children>
																				<RichTextWidget Text="@StringItem" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="MPLobby.Matchmaking.Region.ItemText"/>
																			</Children>
																		</ListPanel>
																	</Children>
																</ButtonWidget>
															</ItemTemplate>
														</BrushListPanel>
													</Children>
												</Widget>
											</Children>
										</ScrollablePanel>
										<ScrollbarWidget Id="FileVerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="15" HorizontalAlignment="Right" VerticalAlignment="Center" AlignmentAxis="Vertical" Handle="FileVerticalScrollbarHandle" MaxValue="100" MinValue="0">
											<Children>
												<Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="6" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" AlphaFactor="0.2" Color="#5a4033FF" />
												<ImageWidget Id="FileVerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="12" SuggestedHeight="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
											</Children>
										</ScrollbarWidget>
									</Children>
								</BrushWidget>
							</Children>
						</DirectionalListPanelDropdownWidget>

					</Children>
				</Widget>

			</Children>
		</BrushWidget>

	</Window>
</Prefab>