<Prefab>
	<Parameters>
		<Parameter Name="HintText" DefaultValue="NoHint"/>
	</Parameters>
	<Constants>
		<Constant Name="Encyclopedia.Frame.Width" BrushLayer="Default" BrushName="Encyclopedia.Frame" BrushValueType="Width" />
		<Constant Name="Encyclopedia.Frame.Height" BrushLayer="Default" BrushName="Encyclopedia.Frame" BrushValueType="Height" />
	</Constants>
	<VisualDefinitions>
	</VisualDefinitions>
	<Window>
		
		<Widget IsVisible="@IsVisible" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
			<Children>
				<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="HorizontalLeftToRight" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="88" >
					<Children>
						<!-- Tab to display Admin View -->
						<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="280" SuggestedHeight="48" HorizontalAlignment="Center" VerticalAlignment="Top" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Brush="Header.Tab.Center" Command.Click="OpenAdminTab" IsSelected="@ShowAdminTab">
							<Children>
								<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="28" Text="Admin View" />
							</Children>
						</ButtonWidget>
						<!-- Tab to display Players permissions & sanctions -->
						<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="280" SuggestedHeight="48" HorizontalAlignment="Center" VerticalAlignment="Top" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Brush="Header.Tab.Center" Command.Click="OpenPlayerTab" IsSelected="@ShowPlayerTab">
							<Children>
								<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="28" IsDisabled="true" Text="Permissions &amp; bans" />
							</Children>
						</ButtonWidget>
						<!-- Tab to display current config -->
						<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="280" SuggestedHeight="48" HorizontalAlignment="Center" VerticalAlignment="Top" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Brush="Header.Tab.Center" Command.Click="OpenToolsTab" IsSelected="@ShowToolsTab">
							<Children>
								<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush.FontSize="28" IsDisabled="true" Text="Game options" />
							</Children>
						</ButtonWidget>
					</Children>
				</ListPanel>

				<!-- Admin View -->
				<TabAdmin/>

				<!-- Permissions & bans View -->
				<TabPlayers/>
				
				<!-- Options View -->
				<TabOptions/>

			</Children>
		</Widget>

	</Window>
</Prefab>