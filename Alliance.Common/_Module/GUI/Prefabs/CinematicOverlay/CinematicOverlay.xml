<Prefab>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Children>
				<BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="WhiteSquareBrush" Brush.Color="#000000FF" Brush.GlobalAlphaFactor="@FadeAlpha" />
				<BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="@LetterboxHeight" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="WhiteSquareBrush" Brush.Color="#000000FF" />
				<BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="@LetterboxHeight" HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="WhiteSquareBrush" Brush.Color="#000000FF" />
				<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="40" MarginBottom="45"
							Text="@SkipHint" Brush="Alliance.Cinematic.Subtitle" Brush.FontColor="#FFFFFFFF" Brush.FontSize="18" IsVisible="@IsSkippable" />
				<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DataSource="{Subtitles}">
					<ItemTemplate>
						<TextWidget Id="SubtitleText" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
									VerticalAlignment="@VAlign"
									Text="@Text" Brush="Alliance.Cinematic.Subtitle"
									Brush.GlobalAlphaFactor="@Alpha" Brush.FontSize="@FontSize"
									Brush.FontColor="@FontColor" Brush.Font="@FontObject" Brush.TextHorizontalAlignment="@HAlign"
									MarginLeft="80" MarginRight="80" MarginTop="@MarginTop" MarginBottom="40" />
					</ItemTemplate>
				</Widget>
			</Children>
		</Widget>
	</Window>
</Prefab>
