<UserControl x:Class="Alliance.Editor.GameModes.Story.Views.ObjectEditorContentControl"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:Alliance.Editor.GameModes.Story.ViewModels"
		xmlns:sys="clr-namespace:System;assembly=mscorlib"
		xmlns:system="clr-namespace:System;assembly=mscorlib"
		mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ModernTheme.xaml" />
				<ResourceDictionary Source="ScenarioEditorResources.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!-- Implicit templates for the phrase segments (selected by runtime item type) -->
			<DataTemplate DataType="{x:Type vm:PhraseTextSegment}">
				<TextBlock Text="{Binding Text}" VerticalAlignment="Center" Margin="3,0"
						   FontSize="18" FontWeight="Medium" Foreground="#FF2B2B2B" />
			</DataTemplate>
			<DataTemplate DataType="{x:Type vm:PhraseFieldSegment}">
				<Border Background="#FFF1F3F5" BorderBrush="#FFCFD4DA" BorderThickness="1" CornerRadius="4"
						Padding="4,1" Margin="3,1" VerticalAlignment="Center">
					<ContentControl Content="{Binding Field}" ContentTemplate="{StaticResource InlineFieldTemplate}" VerticalAlignment="Center" />
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="0, 4, 0, 12">
			<!-- Inline phrase view (shown when the edited type declares a [PhraseTemplate]) -->
			<ItemsControl ItemsSource="{Binding PhraseLines}"
						  Visibility="{Binding HasPhrase, Converter={StaticResource BoolToVisibilityConverter}}"
						  Margin="0,8,0,0"
						  HorizontalAlignment="Center">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ItemsControl ItemsSource="{Binding Segments}" Margin="0,3" HorizontalAlignment="Center">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<!-- Flat fields view -->
			<ItemsControl ItemsSource="{Binding Fields}" Margin="24, 0, 0, 0">
				<ItemsControl.ItemTemplate>
					<StaticResource ResourceKey="FieldTemplate"/>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<!-- Categories view -->
			<ItemsControl ItemsSource="{Binding FieldCategories}" Margin="24, 0, 0, 0">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Expander Header="{Binding Name}" 
								  IsExpanded="{Binding IsExpanded, Mode=TwoWay}" 
								  Margin="-12, 0, 0, 0">
							<ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
								<ItemsControl.ItemTemplate>
									<StaticResource ResourceKey="FieldTemplate"/>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Expander>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</ScrollViewer>
</UserControl>

