<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:sys="clr-namespace:System;assembly=mscorlib"
					xmlns:vm="clr-namespace:Alliance.Editor.GameModes.Story.ViewModels"
					xmlns:widgets="clr-namespace:Alliance.Editor.GameModes.Story.Widgets" xmlns:local="clr-namespace:Alliance.Editor.GameModes.Story" xmlns:views="clr-namespace:Alliance.Editor.GameModes.Story.Views">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="ModernTheme.xaml" />
	</ResourceDictionary.MergedDictionaries>
	
	<!-- Font and color definitions -->
	<FontFamily x:Key="DefaultFontFamily">Arial</FontFamily>
	<sys:Double x:Key="DefaultFontSize">16</sys:Double>
	<SolidColorBrush x:Key="DefaultFontColor">#FF000000</SolidColorBrush>
	
	<!-- Default values for TextBox -->
	<Style TargetType="TextBox">
		<Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
		<Setter Property="Foreground" Value="{StaticResource DefaultFontColor}" />
	</Style>

	<Style TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
		<Setter Property="Foreground" Value="{StaticResource DefaultFontColor}" />
	</Style>

	<vm:EnumToListConverter x:Key="EnumToListConverter" />
	<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	<widgets:HexToBrushConverter x:Key="HexToBrushConverter" />

	<!-- Template for a label with a tooltip (optional) -->
	<DataTemplate x:Key="LabelWithTooltipTemplate">
		<StackPanel Height="24" 
					Width="200" 
					Margin="0,0,16,0"
					Orientation="Horizontal" 
					VerticalAlignment="Center">
			<Image
				Source="pack://application:,,,/Alliance.Editor;component/Resources/alliance_help2.png"
				Width="24"
				Height="24"
				VerticalAlignment="Center"
				HorizontalAlignment="Left"
				Margin="-4,0,4,2"
				Visibility="{Binding ShowTooltip, Converter={StaticResource BoolToVisibilityConverter}}">
				<Image.ToolTip>
					<ToolTip Content="{Binding Tooltip}" />
				</Image.ToolTip>
			</Image>

			<!-- Text for the label with trimming and tooltip for long text -->
			<TextBlock Text="{Binding Label}" 
					   VerticalAlignment="Center" 
					   FontFamily="{StaticResource DefaultFontFamily}" 
					   FontSize="{StaticResource DefaultFontSize}"
					   TextTrimming="CharacterEllipsis"
					   ToolTip="{Binding Label}" />
		</StackPanel>
	</DataTemplate>

	<!-- Template for basic strings -->
	<DataTemplate x:Key="StringTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<TextBox Text="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					 Width="264"
					 VerticalAlignment="Center">
				<TextBox.ToolTip>
					<ToolTip Content="{Binding Tooltip}" />
				</TextBox.ToolTip>
			</TextBox>
		</StackPanel>
	</DataTemplate>

	<!-- Template for hex color strings -->
	<DataTemplate x:Key="ColorStringTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<widgets:ColorPickerBox Text="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Width="200" Height="24"
									VerticalAlignment="Center">
				<widgets:ColorPickerBox.ToolTip>
					<ToolTip Content="{Binding Tooltip}" />
				</widgets:ColorPickerBox.ToolTip>
			</widgets:ColorPickerBox>
		</StackPanel>
	</DataTemplate>

	<!-- Template for strings with multiple choices -->
	<DataTemplate x:Key="StringMultiChoiceTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

		<ComboBox ItemsSource="{Binding PossibleValues}"
			  Text="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			  FontFamily="{StaticResource DefaultFontFamily}"
			  FontSize="{StaticResource DefaultFontSize}"
			  Foreground="{StaticResource DefaultFontColor}"
			  Width="264"
			  VerticalAlignment="Center"
			  ToolTip="{Binding Tooltip}"
			  VirtualizingStackPanel.IsVirtualizing="True"
			  ScrollViewer.CanContentScroll="True">
			<ComboBox.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel VirtualizingStackPanel.IsVirtualizing="True" />
				</ItemsPanelTemplate>
			</ComboBox.ItemsPanel>
			<ComboBox.Style>
				<Style TargetType="ComboBox">
					<Setter Property="IsEditable" Value="True"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsChoiceLocked}" Value="True">
							<Setter Property="IsEditable" Value="False"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ComboBox.Style>
		</ComboBox>
		</StackPanel>
	</DataTemplate>

	<!-- Template for LocalizedString values -->
	<DataTemplate x:Key="LocalizedStringTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<TextBox Text="{Binding LocalizedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				 Width="264"
				 VerticalAlignment="Center">
				<TextBox.ToolTip>
					<ToolTip Content="{Binding Tooltip}" />
				</TextBox.ToolTip>
			</TextBox>
		</StackPanel>
	</DataTemplate>

	<!-- Template for Boolean values -->
	<DataTemplate x:Key="BooleanTemplate" DataType="{x:Type sys:Boolean}">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />
			<CheckBox IsChecked="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					  Margin="0,0,0,0">
				<CheckBox.LayoutTransform>
					<ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
				</CheckBox.LayoutTransform>
			</CheckBox>
		</StackPanel>
	</DataTemplate>

	<!-- Design for NumericTemplate (int, double, float, etc.) -->
	<Style TargetType="{x:Type widgets:NumericUpDownBox}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type widgets:NumericUpDownBox}">
					<StackPanel Orientation="Horizontal" >
						<Button x:Name="PART_DecrementButton" Content="-" Width="24" Height="24" Padding="0, 0, 0, 4"/>
						<TextBox x:Name="PART_TextBox" 
								 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								 Width="80" 
								 Height="26"
								 Margin="0"
								 Padding="0,1.3,0,0"
								 HorizontalAlignment="Center" 
								 VerticalAlignment="Center" 
								 TextAlignment="Center" />
						<Button x:Name="PART_IncrementButton" Content="+" Width="24" Height="24" Padding="0, 0, 0, 4"/>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Compact variant of NumericUpDownBox for inline (phrase) numerics. -->
	<Style x:Key="InlineNumericUpDownStyle" TargetType="{x:Type widgets:NumericUpDownBox}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type widgets:NumericUpDownBox}">
					<StackPanel Orientation="Horizontal">
						<Button x:Name="PART_DecrementButton" Content="-" Width="18" Height="22" Padding="0,0,0,3"/>
						<TextBox x:Name="PART_TextBox"
									 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Width="56" Padding="0,3" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
						<Button x:Name="PART_IncrementButton" Content="+" Width="18" Height="22" Padding="0,0,0,3"/>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Hex color picker (#RRGGBBAA): swatch + validated text box + palette/RGB slider popup. -->
	<Style TargetType="{x:Type widgets:ColorPickerBox}">
		<Setter Property="Height" Value="26"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type widgets:ColorPickerBox}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<Border x:Name="PART_Swatch" Width="26" Height="18" CornerRadius="2" BorderBrush="#FF8A929C"
								BorderThickness="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
						<TextBox x:Name="PART_TextBox" Grid.Column="1" Padding="2" VerticalContentAlignment="Center"
								 VerticalAlignment="Stretch" BorderThickness="1"/>
						<ToggleButton x:Name="PART_DropDownToggle" Grid.Column="2" Content="▾" Width="22" FontSize="10"
									 Focusable="False" TabIndex="-1"/>
						<Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom"
							   PlacementTarget="{Binding ElementName=PART_TextBox}">
							<Border Background="#FFF5F6F8" BorderBrush="#FF8A929C" BorderThickness="1" CornerRadius="4"
									Padding="10" Margin="12" Width="248">
								<Border.Effect>
									<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
								</Border.Effect>
								<StackPanel>
									<TextBlock Text="Presets" FontSize="12" Foreground="#FF6B7480" Margin="0,0,0,4"/>
									<ItemsControl x:Name="PART_Palette">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button Focusable="False" Cursor="Hand" Margin="1" ToolTip="{Binding}">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border x:Name="Bd" Width="20" Height="20" CornerRadius="3" BorderBrush="#FF8A929C"
																	BorderThickness="1" Background="{Binding Converter={StaticResource HexToBrushConverter}}"/>
															<ControlTemplate.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter TargetName="Bd" Property="BorderBrush" Value="#FF1F6FEB"/>
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="Components" FontSize="12" Foreground="#FF6B7480" Margin="0,10,0,4"/>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="16"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="28"/>
										</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<TextBlock Text="R" Grid.Row="0" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
									<Slider x:Name="PART_RedSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Margin="2,2" Focusable="False"/>
									<TextBlock x:Name="PART_RedValue" Grid.Row="0" Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
									<TextBlock Text="G" Grid.Row="1" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
									<Slider x:Name="PART_GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Margin="2,2" Focusable="False"/>
									<TextBlock x:Name="PART_GreenValue" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
									<TextBlock Text="B" Grid.Row="2" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
									<Slider x:Name="PART_BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Margin="2,2" Focusable="False"/>
									<TextBlock x:Name="PART_BlueValue" Grid.Row="2" Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
								</Grid>
								</StackPanel>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Template definition for numeric -->
	<DataTemplate x:Key="NumericTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />
			<widgets:NumericUpDownBox Value="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
									HorizontalAlignment="Center" 
									VerticalAlignment="Center"
									Margin="2,0,0,0"/>
		</StackPanel>
	</DataTemplate>

	<!-- Template for Enum values -->
	<DataTemplate x:Key="EnumTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<ComboBox ItemsSource="{Binding FieldValue, Converter={StaticResource EnumToListConverter}}"
				  SelectedItem="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				  FontFamily="{StaticResource DefaultFontFamily}"
				  FontSize="{StaticResource DefaultFontSize}"
				  Foreground="{StaticResource DefaultFontColor}"
				  Width="248"
				  VerticalAlignment="Center"/>
		</StackPanel>
	</DataTemplate>

	<!-- Template for a button to edit a complex object -->
	<DataTemplate x:Key="EditButtonTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />
			<Button Content="Edit"
					Command="{Binding EditCommand}"
					Height="24"
					Width="184"
					Margin="0,0,0,0"
					Padding="0, 0, 0, 0"
					HorizontalAlignment="Center"
					FontFamily="{StaticResource DefaultFontFamily}"
					FontSize="{StaticResource DefaultFontSize}"/>
		</StackPanel>
	</DataTemplate>
	
	<!-- Inline editor for a polymorphic (abstract-typed) field: subtype picker + nested fields. -->
	<DataTemplate x:Key="PolymorphicFieldTemplate">
		<StackPanel Orientation="Vertical" Margin="0,8,0,0" >
			<StackPanel Orientation="Horizontal">
				<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />
				<ComboBox ItemsSource="{Binding ConcreteTypes}" DisplayMemberPath="Name"
							SelectedItem="{Binding SelectedConcreteType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Width="220" VerticalAlignment="Center" />
			</StackPanel>
			<views:ObjectEditorContentControl DataContext="{Binding NestedVM}" Margin="16,4,0,0" />
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="InlinePolymorphicFieldTemplate">
		<StackPanel Orientation="Vertical" VerticalAlignment="Center">
			<ComboBox ItemsSource="{Binding ConcreteTypes}" DisplayMemberPath="Name"
						SelectedItem="{Binding SelectedConcreteType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Width="160" VerticalAlignment="Center" Margin="2,0" />
			<views:ObjectEditorContentControl DataContext="{Binding NestedVM}" Margin="0,2,0,0" />
		</StackPanel>
	</DataTemplate>

	<!-- Implicit editor for a ZoneViewModel: centered Edit button + compact Anchor/Shape + inline Position. -->
	<DataTemplate DataType="{x:Type vm:ZoneViewModel}">
		<Border BorderBrush="#FFCFD4DA" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="-8,0,0,4" MinWidth="496">
			<StackPanel Orientation="Vertical">
				<!-- Anchor and Shape fields (Position hidden; rendered inline below) -->
				<ItemsControl ItemsSource="{Binding ZoneEditor.Fields}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ContentControl Content="{Binding}" ContentTemplate="{StaticResource PolymorphicFieldTemplate}" Margin="0,2,0,0"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<!-- Centered Edit Zone button -->
				<Button Content="Place Zone on map" Command="{Binding EditZoneCommand}" 
						HorizontalAlignment="Center" Height="24" Width="160" Padding="0,0,0,1"
						FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						Margin="0,0,0,4"
						ToolTip="Click to position this zone on the map."/>
				<!-- Position inline (under Shape) -->
				<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
					<TextBlock Text="Position" VerticalAlignment="Center" Width="100" FontSize="16"/>
					<TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,1,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}"
											 Value="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											 VerticalAlignment="Center"/>
					<TextBlock Text="Y:" VerticalAlignment="Center" Margin="24,0,1,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}"
											 Value="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											 VerticalAlignment="Center"/>
					<TextBlock Text="Z:" VerticalAlignment="Center" Margin="24,0,1,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}"
											 Value="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											 VerticalAlignment="Center"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</DataTemplate>

	<!-- Template for a direct Zone field (e.g. NamedZone.Zone): label + zone editor. -->
	<DataTemplate x:Key="ZoneTemplate">
		<StackPanel Orientation="Vertical">
			<ContentControl Content="{Binding ZoneVM}" VerticalAlignment="Top" Width="Auto"/>
		</StackPanel>
	</DataTemplate>

	<!-- Implicit editor for an EntityRefViewModel: "Select entity on map" button + picked entity name. -->
	<DataTemplate DataType="{x:Type vm:EntityRefViewModel}">
		<Border BorderBrush="#FFCFD4DA" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="-8,0,0,4" MinWidth="300">
			<StackPanel Orientation="Vertical">
				<Button Content="Select entity on map" Command="{Binding PickEntityCommand}"
						HorizontalAlignment="Center" Height="24" Width="180" Padding="0,0,0,1"
						FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						Margin="0,0,0,4"
						ToolTip="Click, then select an entity in the scene to attach a marker and reference it."/>
				<TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center"
						   FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						   Foreground="#FF555555" Margin="0,2,0,0"/>
			</StackPanel>
		</Border>
	</DataTemplate>

	<!-- Template for a direct GameEntityRef field (e.g. SceneEntityLiteralValue.Ref): pick editor. -->
	<DataTemplate x:Key="EntityRefTemplate">
		<StackPanel Orientation="Vertical">
			<ContentControl Content="{Binding EntityRefVM}" VerticalAlignment="Top" Width="Auto"/>
		</StackPanel>
	</DataTemplate>

	<!-- Template for a direct FrameValue field (e.g. FrameLiteralValue.Frame): placement editor. -->
	<DataTemplate x:Key="FrameTemplate">
		<StackPanel Orientation="Vertical">
			<ContentControl Content="{Binding FrameVM}" VerticalAlignment="Top" Width="Auto"/>
		</StackPanel>
	</DataTemplate>

	<!-- All runtime value slots are compact hyperlinks. Clicking opens Literal / Variable / Function editing -->
	<DataTemplate x:Key="ValueSourceTemplate">
		<StackPanel Orientation="Horizontal">
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />
			<Button Command="{Binding ValueSourceChip.OpenCommand}"
					ToolTip="{Binding ValueSourceChip.ToolTip}"
					Background="Transparent"
					BorderThickness="0"
					Height="28"
					Padding="4,1"
					VerticalAlignment="Center">
				<TextBlock Text="{Binding ValueSourceChip.DisplayText}"
						   Foreground="CornflowerBlue"
						   TextDecorations="Underline"
						   FontWeight="SemiBold"/>
			</Button>
		</StackPanel>
	</DataTemplate>

	<!-- Template for PlayerSpawnMenu - Show button to open the menu directly -->
	<DataTemplate x:Key="PlayerSpawnMenuTemplate">
		<StackPanel Orientation="Horizontal">
			<!-- Include the Label/Tooltip -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<Button Content="Edit"
					Command="{Binding EditPlayerSpawnMenuCommand}"
					Height="24"
					Width="128"
					Padding="0, 0, 0, 0"
					FontFamily="{StaticResource DefaultFontFamily}"
					FontSize="{StaticResource DefaultFontSize}"/>
		</StackPanel>
	</DataTemplate>

	<!-- Template for Cinematic - Show button to open the dedicated timeline editor -->
	<DataTemplate x:Key="CinematicTemplate">
		<StackPanel Orientation="Horizontal">
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" VerticalAlignment="Center" />

			<Button Content="Open Editor"
					Command="{Binding EditCinematicCommand}"
					Height="24"
					Width="128"
					Padding="0, 0, 0, 0"
					FontFamily="{StaticResource DefaultFontFamily}"
					FontSize="{StaticResource DefaultFontSize}"/>
		</StackPanel>
	</DataTemplate>

	<!-- Button content that wraps long text (capped to a few lines) instead of stretching the button. -->
	<DataTemplate x:Key="WrappingButtonText">
		<TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" />
	</DataTemplate>

	<!-- Template for List values -->
	<DataTemplate x:Key="ListTemplate">
		<StackPanel Orientation="Vertical" Margin="0,12,0,24">
			<!-- Label for the list -->
			<ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelWithTooltipTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" />

			<!-- ItemsControl to display the list items (with drag-drop reordering) -->
			<ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Left"
						  local:DragDropReorderHelper.IsEnabled="True">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border BorderThickness="6,0,0,0" BorderBrush="Transparent"
								Padding="0" Margin="0,4,0,0" Cursor="Hand">
							<Border.Style>
								<Style TargetType="Border">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
											<Setter Property="Background" Value="#440D6EFD" />
											<Setter Property="BorderBrush" Value="#FF0D6EFD" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid>
								<Border Background="#440D6EFD" CornerRadius="3"
										IsHitTestVisible="False"
										Visibility="Collapsed">
									<Border.Style>
										<Style TargetType="Border">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
								</Border>
								<StackPanel Orientation="Horizontal">
									<Button Content="{Binding DisplayName}"
											Command="{Binding EditCommand}"
											ContentTemplate="{StaticResource WrappingButtonText}"
											ToolTip="{Binding DisplayName}"
											Width="463"
											Margin="0"
											Padding="4,2"
											FontFamily="{StaticResource DefaultFontFamily}"
											FontSize="{StaticResource DefaultFontSize}">
										<Button.Style>
											<Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
														<Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
														<Setter Property="Foreground" Value="White" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
									</Button>
									<Button Content="X"
											Command="{Binding DeleteCommand}"
											Height="24"
											Width="24"
											Margin="8, 0, 0, 0"
											Background="DarkRed"
											VerticalAlignment="Center"
											Padding="0, 0, 0, 0"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Button to add a new item to the list -->
			<Button Content="Add" 
					Command="{Binding AddCommand}" 
					Height="24" 
					Width="56" 
					Margin="2,10,0,0"
					Padding="0, 0, 4, 2"
					HorizontalAlignment="Center"/>
			<Line Stroke="Black" X1="0" X2="216" Y1="0" Y2="0" StrokeThickness="1" Margin="0, -12, 0, 0"/>
			<Line Stroke="Black" X1="0" X2="216" Y1="0" Y2="0" StrokeThickness="1" Margin="288, -12, 0, 0"/>
		</StackPanel>
	</DataTemplate>

	<!-- Template for an individual field (dispatches to the correct editor by type). -->
	<DataTemplate x:Key="FieldTemplate">
		<StackPanel Orientation="Horizontal">
			<ContentControl Content="{Binding}" Margin="0, 8, 0, 0" VerticalAlignment="Center">
				<ContentControl.Style>
					<Style TargetType="ContentControl">
						<Style.Triggers>
							<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:String}">
								<Setter Property="ContentTemplate" Value="{StaticResource StringTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsColorString}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource ColorStringTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsMultiChoiceString}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource StringMultiChoiceTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsLocalizedString}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource LocalizedStringTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Boolean}">
								<Setter Property="ContentTemplate" Value="{StaticResource BooleanTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding FieldType.IsEnum}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource EnumTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Int32}">
								<Setter Property="ContentTemplate" Value="{StaticResource NumericTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Double}">
								<Setter Property="ContentTemplate" Value="{StaticResource NumericTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Single}">
								<Setter Property="ContentTemplate" Value="{StaticResource NumericTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsCollection}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource ListTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsComplexType}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource EditButtonTemplate}"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding IsPolymorphicField}" Value="True">
								<Setter Property="ContentTemplate" Value="{StaticResource PolymorphicFieldTemplate}"/>
							</DataTrigger>
						<DataTrigger Binding="{Binding IsZone}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource ZoneTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsGameEntityRef}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource EntityRefTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsFrameValue}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource FrameTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsPlayerSpawnMenu}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource PlayerSpawnMenuTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsCinematic}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource CinematicTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsValueSource}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource ValueSourceTemplate}"/>
						</DataTrigger>
						</Style.Triggers>
					</Style>
				</ContentControl.Style>
			</ContentControl>
		</StackPanel>
	</DataTemplate>

	<!-- ===== Inline (phrase) templates: label-less, compact variants of the editors above ===== -->

	<DataTemplate x:Key="InlineStringTemplate">
		<TextBox Text="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
					Height="32" Width="160" VerticalAlignment="Center" Margin="4,0" Padding="0"
					ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<DataTemplate x:Key="InlineStringMultiChoiceTemplate">
		<ComboBox ItemsSource="{Binding PossibleValues}"
					Text="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					FontSize="14"
					VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
					Height="32" MaxWidth="240" local:ComboBoxAutoSize.AutoSize="True" VerticalAlignment="Center" Margin="4,0"
					ToolTip="{Binding Tooltip}"
					VirtualizingStackPanel.IsVirtualizing="True"
					ScrollViewer.CanContentScroll="True">
			<ComboBox.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel VirtualizingStackPanel.IsVirtualizing="True" />
				</ItemsPanelTemplate>
			</ComboBox.ItemsPanel>
			<ComboBox.Style>
				<Style TargetType="ComboBox">
					<Setter Property="IsEditable" Value="True"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsChoiceLocked}" Value="True">
							<Setter Property="IsEditable" Value="False"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ComboBox.Style>
		</ComboBox>
	</DataTemplate>

	<DataTemplate x:Key="InlineLocalizedStringTemplate">
		<TextBox Text="{Binding LocalizedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Width="160" VerticalAlignment="Center" Margin="4,0"
					ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<DataTemplate x:Key="InlineBooleanTemplate">
		<CheckBox IsChecked="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					VerticalAlignment="Center" Margin="4,0"
					ToolTip="{Binding Tooltip}">
			<CheckBox.LayoutTransform>
				<ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
			</CheckBox.LayoutTransform>
		</CheckBox>
	</DataTemplate>

	<DataTemplate x:Key="InlineEnumTemplate">
		<ComboBox ItemsSource="{Binding FieldValue, Converter={StaticResource EnumToListConverter}}"
					VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
					SelectedItem="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					MaxWidth="240" local:ComboBoxAutoSize.AutoSize="True" VerticalAlignment="Center" Margin="4,0"
					ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<!-- Inline choice dropdown for {Field|Label0|Label1|...} slots (bool → 0/1, enum → declaration order). -->
	<DataTemplate x:Key="InlineChoiceTemplate">
		<ComboBox ItemsSource="{Binding ChoiceLabels}"
					SelectedIndex="{Binding SelectedChoiceIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					MaxWidth="240" local:ComboBoxAutoSize.AutoSize="True" VerticalAlignment="Center" Margin="4,0"
					ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<DataTemplate x:Key="InlineNumericTemplate">
		<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}"
									Value="{Binding FieldValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									VerticalAlignment="Center" Margin="4,0"
									ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<!-- Compact edit button for complex fields embedded in a phrase (zones, nested objects, lists). -->
	<DataTemplate x:Key="InlineEditButtonTemplate">
		<Button Content="{Binding Label}" Command="{Binding InlineEditCommand}"
				Height="24" Margin="4,0" Padding="8,0"
				FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
				ToolTip="{Binding Tooltip}"/>
	</DataTemplate>

	<!-- Inline hyperlink for value source-->
	<DataTemplate x:Key="InlineValueSourceTemplate">
		<Button Command="{Binding ValueSourceChip.OpenCommand}"
				ToolTip="{Binding ValueSourceChip.ToolTip}"
				Background="Transparent"					
				BorderThickness="0"
				Height="28"
				Padding="2,0"
				VerticalAlignment="Center">
			<TextBlock Text="{Binding ValueSourceChip.DisplayText}"
					Foreground="CornflowerBlue"
					TextDecorations="Underline"
					FontWeight="SemiBold"/>
		</Button>
	</DataTemplate>

	<!-- Compact inline editor for a collection: item buttons (edit/delete) + add. Items wrap to fit width. -->
	<DataTemplate x:Key="InlineListTemplate">
		<StackPanel Orientation="Vertical" VerticalAlignment="Center">
			<ItemsControl ItemsSource="{Binding Items}" local:DragDropReorderHelper.IsEnabled="True">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border BorderThickness="4,0,0,0" BorderBrush="Transparent"
								Padding="0" Cursor="Hand">
							<Border.Style>
								<Style TargetType="Border">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
											<Setter Property="Background" Value="#440D6EFD" />
											<Setter Property="BorderBrush" Value="#FF0D6EFD" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid>
								<Border Background="#440D6EFD" CornerRadius="3"
										IsHitTestVisible="False"
										Visibility="Collapsed">
									<Border.Style>
										<Style TargetType="Border">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
								</Border>
								<StackPanel Orientation="Horizontal" Margin="0,0,4,4" VerticalAlignment="Center">
									<Button Content="{Binding DisplayName}" Command="{Binding EditCommand}"
											ContentTemplate="{StaticResource WrappingButtonText}"
											MaxWidth="276" Height="24" Padding="6,0"
											FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
											ToolTip="Edit this item">
										<Button.Style>
											<Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsDropTarget}" Value="True">
														<Setter Property="Background" Value="#660D6EFD" />
														<Setter Property="BorderBrush" Value="#FF0D6EFD" />
														<Setter Property="Foreground" Value="White" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
									</Button>
									<Button Content="×" Command="{Binding DeleteCommand}"
											Height="24" Width="20" Margin="2,0,0,0" Background="DarkRed" Foreground="White" Padding="0"
											FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
											ToolTip="Remove this item" />
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<Button Content="+" Command="{Binding AddCommand}"
					HorizontalAlignment="Left" Margin="0,0,0,4" Height="24" Width="20" Background="Green" Foreground="White" Padding="0"
					FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
					ToolTip="Add an item" />
		</StackPanel>
	</DataTemplate>

	<!-- Dispatcher that picks the right inline template based on the field type (mirrors FieldTemplate order). -->
	<DataTemplate x:Key="InlineFieldTemplate">
		<ContentControl Content="{Binding}" VerticalAlignment="Center">
			<ContentControl.Style>
				<Style TargetType="ContentControl">
					<Style.Triggers>
						<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:String}">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineStringTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsMultiChoiceString}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineStringMultiChoiceTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsLocalizedString}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineLocalizedStringTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Boolean}">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineBooleanTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding FieldType.IsEnum}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineEnumTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Int32}">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineNumericTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Double}">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineNumericTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding FieldType}" Value="{x:Type sys:Single}">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineNumericTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsCollection}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineListTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsComplexType}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineEditButtonTemplate}"/>
						</DataTrigger>
						<!-- Polymorphic fields win over the generic complex edit-button. -->
						<DataTrigger Binding="{Binding IsPolymorphicField}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlinePolymorphicFieldTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsZone}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource ZoneTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsGameEntityRef}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource EntityRefTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsFrameValue}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource FrameTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsPlayerSpawnMenu}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineEditButtonTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsCinematic}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineEditButtonTemplate}"/>
						</DataTrigger>
						<!-- Choice slots win over plain bool/enum (declared last on purpose). -->
						<DataTrigger Binding="{Binding IsChoice}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineChoiceTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding IsValueSource}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource InlineValueSourceTemplate}"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ContentControl.Style>
		</ContentControl>
	</DataTemplate>

	<!-- Implicit editor for a FrameViewModel: position/rotation/scale strings + "Place on map" ghost button. -->
	<DataTemplate DataType="{x:Type vm:FrameViewModel}">
		<Border BorderBrush="#FFCFD4DA" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="-8,0,0,4" MinWidth="420">
			<StackPanel Orientation="Vertical">
				<!-- Position -->
				<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
					<TextBlock Text="Position" VerticalAlignment="Center" Width="90" FontSize="16"/>
					<TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding PositionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding PositionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Z:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding PositionZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
				</StackPanel>
				<!-- Rotation (radians) -->
				<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
					<TextBlock Text="Rotation" VerticalAlignment="Center" Width="90" FontSize="16"/>
					<TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding RotationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding RotationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Z:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding RotationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
				</StackPanel>
				<!-- Scale -->
				<StackPanel Orientation="Horizontal" Margin="0,2,0,0">
					<TextBlock Text="Scale" VerticalAlignment="Center" Width="90" FontSize="16"/>
					<TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding ScaleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding ScaleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
					<TextBlock Text="Z:" VerticalAlignment="Center" Margin="12,0,2,0" FontSize="16"/>
					<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding ScaleZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
				</StackPanel>
				<Button Content="Place on map" Command="{Binding PlaceCommand}"
						HorizontalAlignment="Center" Height="24" Width="160" Padding="0,0,0,1"
						FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						Margin="0,4,0,0"
						ToolTip="Click, then move the ghost in the scene (wheel = rotate, click = confirm)."/>
				<Button Content="Capture from camera" Command="{Binding CaptureFromCameraCommand}"
						HorizontalAlignment="Center" Height="24" Width="180" Padding="0,0,0,1"
						FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						Margin="0,4,0,0"
						ToolTip="Snapshots the current editor fly-camera view into this frame (e.g. a camera keyframe). Fly the editor view to the shot you want, then click."/>
				<Button Content="Copy from origin" Command="{Binding CopyFromOriginCommand}"
						Visibility="{Binding CanCopyFromOrigin, Converter={StaticResource BoolToVisibilityConverter}}"
						HorizontalAlignment="Center" Height="24" Width="160" Padding="0,0,0,1"
						FontFamily="{StaticResource DefaultFontFamily}" FontSize="{StaticResource DefaultFontSize}"
						Margin="0,4,0,0"
						ToolTip="Copy the entity's current frame into the destination."/>
			</StackPanel>
		</Border>
	</DataTemplate>

</ResourceDictionary>
