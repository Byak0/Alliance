<Window x:Class="Alliance.Editor.Extensions.Cinematics.Views.CinematicEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:Alliance.Editor.Extensions.Cinematics.ViewModels"
		xmlns:widgets="clr-namespace:Alliance.Editor.GameModes.Story.Widgets"
		mc:Ignorable="d"
		Title="{Binding Title}" Width="980" SizeToContent="Height" MinHeight="440"
		FontFamily="Arial" FontSize="14"
		Icon="pack://application:,,,/Alliance.Editor;component/Resources/alliance_ico.ico"
		Loaded="Window_Loaded" Closing="Window_Closing">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Alliance.Editor;component/GameModes/Story/Views/ModernTheme.xaml" />
				<ResourceDictionary Source="pack://application:,,,/Alliance.Editor;component/GameModes/Story/Views/ScenarioEditorResources.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<ControlTemplate x:Key="KeyframeMarkerTemplate" TargetType="Thumb">
				<Grid Width="20" Height="20" Margin="-10,-10,0,0">
					<Path x:Name="Diamond" Width="14" Height="14" Stretch="Fill"
						  Data="M7,0 L14,7 L7,14 L0,7 Z"
						  Fill="{Binding MarkerFill}" Stroke="{Binding MarkerStroke}" StrokeThickness="1.5" />
				</Grid>
				<ControlTemplate.Triggers>
					<DataTrigger Binding="{Binding IsSelected}" Value="True">
						<Setter TargetName="Diamond" Property="StrokeThickness" Value="2.5" />
					</DataTrigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>

			<Style x:Key="TrackLabel" TargetType="TextBlock">
				<Setter Property="FontWeight" Value="Bold" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="14,10,14,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header: name (left) + copy/paste (right) -->
		<DockPanel Grid.Row="0" Margin="0,0,0,10">
			<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
				<Button Content="Copy" Width="64" Height="28" Margin="0,0,4,0" Padding="0" Command="{Binding CopyCinematicCommand}" />
				<Button Content="Paste" Width="64" Height="28" Padding="0" Command="{Binding PasteCinematicCommand}" />
			</StackPanel>
			<TextBlock Text="Cinematic Editor - " FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
			<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="Bold" BorderThickness="0,0,0,1" BorderBrush="#FFC8CED5" Padding="0" VerticalAlignment="Center" />
		</DockPanel>

		<!-- Transport -->
		<DockPanel Grid.Row="1" Margin="0,0,0,8">
			<Button Content="{Binding PlayPauseLabel}" Width="90" Height="32" Margin="0,0,6,0" Padding="0" VerticalContentAlignment="Center" Command="{Binding PlayPauseCommand}" />
			<Button Content="■ Stop" Width="78" Height="32" Margin="0,0,12,0" Padding="0" VerticalContentAlignment="Center" Command="{Binding StopCommand}" />
			<CheckBox Content="Loop" IsChecked="{Binding Loop}" VerticalAlignment="Center" Margin="0,0,12,0" />
			<TextBlock VerticalAlignment="Center" HorizontalAlignment="Right"
						Text="{Binding CurrentTime, StringFormat={}{0:F2}s}" />
		</DockPanel>

		<!-- Body: timeline (left) + inspector (right) -->
		<Grid Grid.Row="2" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="340" />
			</Grid.ColumnDefinitions>

			<!-- Timeline -->
			<Grid Grid.Column="0" VerticalAlignment="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="90" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="22" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Slider Grid.Row="0" Grid.Column="1" Margin="14,0,14,2" VerticalAlignment="Center"
						Minimum="0" Maximum="{Binding EffectiveDuration}" Value="{Binding CurrentTime, Mode=TwoWay}"
						SmallChange="0.05" LargeChange="1" TickPlacement="BottomRight" />

				<Grid Grid.Row="1" Grid.Column="1" Height="18" Margin="14,0,14,0">
					<TextBlock Text="0.0s" FontSize="11" Foreground="#FF6B7480" />
					<TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#FF6B7480"
							   Text="{Binding EffectiveDuration, StringFormat={}{0:F1}s}" />
					<Border Height="1" VerticalAlignment="Bottom" Background="#FFC8CED5" />
				</Grid>

				<!-- Camera lane -->
				<Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#FFD1D5DB" BorderThickness="0,0,0,1">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="90" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="22" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="Camera" Style="{StaticResource TrackLabel}" Margin="0,0,0,2" />
							<Button Content="+ Key" Height="20" Padding="2,0" FontSize="10" Command="{Binding AddKeyframeCommand}" />
						</StackPanel>
						<Border Grid.Column="1" x:Name="LaneBorder" Height="36" Background="#FFEDEFF2" ClipToBounds="True"
								SizeChanged="Lane_SizeChanged" MouseLeftButtonDown="Lane_MouseLeftButtonDown">
							<Canvas Height="36">
								<ItemsControl ItemsSource="{Binding Keyframes}">
									<ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="36" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
									<ItemsControl.ItemContainerStyle>
										<Style TargetType="ContentPresenter">
											<Setter Property="Canvas.Left" Value="{Binding X}" />
											<Setter Property="Canvas.Top" Value="18" />
										</Style>
									</ItemsControl.ItemContainerStyle>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Thumb Template="{StaticResource KeyframeMarkerTemplate}" Cursor="Hand"
												   PreviewMouseLeftButtonDown="Marker_PreviewMouseLeftButtonDown"
												   DragDelta="Marker_DragDelta" ToolTip="{Binding Time, StringFormat={}{0:F2}s}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Canvas>
						</Border>
					</Grid>
				</Border>

				<!-- Other tracks -->
				<ItemsControl Grid.Row="3" Grid.ColumnSpan="3" ItemsSource="{Binding OtherTracks}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="#FFD1D5DB" BorderThickness="0,0,0,1">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="22" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" VerticalAlignment="Center">
										<TextBlock Text="{Binding DisplayName}" Style="{StaticResource TrackLabel}" Margin="0,0,0,2" />
										<Button Content="+ Key" Height="20" Padding="2,0" FontSize="10" Command="{Binding AddKeyCommand}" />
									</StackPanel>
									<Border Grid.Column="1" Height="36" Background="#FFEDEFF2" ClipToBounds="True" MouseLeftButtonDown="Lane_MouseLeftButtonDown">
										<Canvas Height="36">
											<ItemsControl ItemsSource="{Binding Markers}">
												<ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="36" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
												<ItemsControl.ItemContainerStyle>
													<Style TargetType="ContentPresenter">
														<Setter Property="Canvas.Left" Value="{Binding X}" />
														<Setter Property="Canvas.Top" Value="18" />
													</Style>
												</ItemsControl.ItemContainerStyle>
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Thumb Template="{StaticResource KeyframeMarkerTemplate}" Cursor="Hand"
															   PreviewMouseLeftButtonDown="Marker_PreviewMouseLeftButtonDown"
															   DragDelta="Marker_DragDelta" ToolTip="{Binding Time, StringFormat={}{0:F2}s}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Canvas>
									</Border>
									<Button Grid.Column="2" Content="✕" FontSize="9" Width="18" Height="18" Margin="2,0,0,0" Padding="0"
											VerticalAlignment="Center" Command="{Binding DeleteCommand}" ToolTip="Delete track" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- Playhead cursor overlay -->
				<Grid Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" IsHitTestVisible="False">
					<Rectangle Width="2" Fill="#FF2F6FB0" VerticalAlignment="Stretch" HorizontalAlignment="Left">
						<Rectangle.RenderTransform><TranslateTransform X="{Binding PlayheadX}" /></Rectangle.RenderTransform>
					</Rectangle>
				</Grid>

				<StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
					<ComboBox Width="140" ItemsSource="{Binding AvailableTrackTypes}" SelectedItem="{Binding SelectedTrackType}" VerticalContentAlignment="Center" />
					<Button Content="+ Add Track" Height="28" Margin="8,0,0,0" Padding="8,0" VerticalContentAlignment="Center" Command="{Binding AddTrackCommand}" />
				</StackPanel>
			</Grid>

			<!-- Inspector -->
			<Border Grid.Column="1" Background="#FFF6F8FA" BorderBrush="#FFBFC6CF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="12,20,0,0">
				<Grid>
					<TextBlock VerticalAlignment="Top" Foreground="#FF8A929C" FontSize="13"
							   Text="Select or add a keyframe to edit it."
							   Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

					<!-- Camera keyframe inspector -->
					<StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
						<DockPanel Margin="0,0,0,8">
							<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
								<Button Content="Copy" Width="56" Height="24" Margin="0,0,4,0" Padding="0" FontSize="11" Command="{Binding CopyKeyframeCommand}" />
								<Button Content="Paste" Width="56" Height="24" Padding="0" FontSize="11" Command="{Binding PasteKeyframeCommand}" />
							</StackPanel>
							<TextBlock Text="Camera Key" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
						</DockPanel>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<TextBlock Text="Interpolation" FontSize="11" Foreground="#FF6B7480" VerticalAlignment="Center" Margin="0,0,6,0" />
							<ComboBox Width="120" FontSize="11"
										ItemsSource="{Binding SelectedKeyframe.InterpolationOptions}"
										SelectedItem="{Binding SelectedKeyframe.Interpolation}" />
						</StackPanel>

						<StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedKeyframe.IsCatmullRom, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Text="Tension" FontSize="11" Foreground="#FF6B7480" />
							<DockPanel>
								<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.Tension}" DockPanel.Dock="Right" Margin="4,0,0,0" />
								<Slider Value="{Binding SelectedKeyframe.Tension}" Minimum="-1" Maximum="1" SmallChange="0.05" VerticalAlignment="Center" />
							</DockPanel>
						</StackPanel>

						<TextBlock Text="Time &amp; Lens" Foreground="#FF6B7480" FontSize="12" Margin="0,0,0,4" />
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
							<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,4">
								<TextBlock Text="Time (s)" FontSize="11" Foreground="#FF6B7480" />
								<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.Time}" />
							</StackPanel>
							<StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,4">
								<TextBlock Text="FOV" FontSize="11" Foreground="#FF6B7480" />
								<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.Fov}" />
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
								<TextBlock Text="Near" FontSize="11" Foreground="#FF6B7480" />
								<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.NearPlane}" />
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
								<TextBlock Text="Far" FontSize="11" Foreground="#FF6B7480" />
								<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.FarPlane}" />
							</StackPanel>
						</Grid>

						<TextBlock Text="Position" Foreground="#FF6B7480" FontSize="12" Margin="0,4,0,4" />
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.PositionX}" /></StackPanel>
							<StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBlock Text="Y" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.PositionY}" /></StackPanel>
							<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.PositionZ}" /></StackPanel>
						</Grid>

						<TextBlock Text="Rotation (°)" Foreground="#FF6B7480" FontSize="12" Margin="0,4,0,4"
								   Visibility="{Binding SelectedKeyframe.HasNoTarget, Converter={StaticResource BoolToVisibilityConverter}}" />
						<Grid Margin="0,0,0,10" Visibility="{Binding SelectedKeyframe.HasNoTarget, Converter={StaticResource BoolToVisibilityConverter}}">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Pitch" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.RotationXDeg}" /></StackPanel>
							<StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBlock Text="Roll" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.RotationYDeg}" /></StackPanel>
							<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Yaw" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.RotationZDeg}" /></StackPanel>
						</Grid>

						<TextBlock Text="Target" Foreground="#FF6B7480" FontSize="12" Margin="0,4,0,4" />
						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<TextBlock Text="Look at" FontSize="11" Foreground="#FF6B7480" VerticalAlignment="Center" Margin="0,0,6,0" />
							<ComboBox Width="120" FontSize="11"
										ItemsSource="{Binding SelectedKeyframe.LookAtOptions}"
										SelectedItem="{Binding SelectedKeyframe.LookAt}" />
						</StackPanel>
						<StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedKeyframe.IsTargetEntity, Converter={StaticResource BoolToVisibilityConverter}}">
							<Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left"
									Command="{Binding SelectedKeyframe.PickTargetEntityCommand}" ToolTip="Open entity editor">
								<TextBlock Text="{Binding SelectedKeyframe.LookAtEntityDisplayName}" Foreground="CornflowerBlue" TextDecorations="Underline" FontSize="13" />
							</Button>
						</StackPanel>
						<StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedKeyframe.IsTargetPosition, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Text="Target position" FontSize="11" Foreground="#FF6B7480" />
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.LookAtPosX}" /></StackPanel>
								<StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBlock Text="Y" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.LookAtPosY}" /></StackPanel>
								<StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBlock Text="Z" FontSize="11" Foreground="#FF6B7480" /><widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedKeyframe.LookAtPosZ}" /></StackPanel>
							</Grid>
						</StackPanel>

						<StackPanel Orientation="Horizontal">
							<Button Content="Capture View" Height="30" Width="120" Margin="0,0,6,0" Padding="0" VerticalContentAlignment="Center" Command="{Binding SelectedKeyframe.CaptureCommand}" />
							<Button Content="Delete" Height="30" Width="80" Padding="0" VerticalContentAlignment="Center" Command="{Binding SelectedKeyframe.DeleteCommand}" />
						</StackPanel>
					</StackPanel>

					<!-- Generic keyframe inspector -->
					<StackPanel Visibility="{Binding HasGenericSelection, Converter={StaticResource BoolToVisibilityConverter}}">
						<DockPanel Margin="0,0,0,8">
							<StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
								<Button Content="Copy" Width="56" Height="24" Margin="0,0,4,0" Padding="0" FontSize="11" Command="{Binding CopyKeyframeCommand}" />
								<Button Content="Paste" Width="56" Height="24" Padding="0" FontSize="11" Command="{Binding PasteKeyframeCommand}" />
							</StackPanel>
							<TextBlock Text="{Binding SelectedGenericKeyframe.KeyTypeName}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
						</DockPanel>

						<StackPanel Margin="0,0,0,8">
							<TextBlock Text="Time (s)" FontSize="11" Foreground="#FF6B7480" />
							<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding SelectedGenericKeyframe.Time}" />
						</StackPanel>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
							<TextBlock Text="Interpolation" FontSize="11" Foreground="#FF6B7480" VerticalAlignment="Center" Margin="0,0,6,0" />
							<ComboBox Width="120" FontSize="11"
										ItemsSource="{Binding SelectedGenericKeyframe.InterpolationOptions}"
										SelectedItem="{Binding SelectedGenericKeyframe.Interpolation}" />
						</StackPanel>

						<ContentControl Content="{Binding SelectedGenericKeyframe}">
							<ContentControl.Resources>
								<DataTemplate DataType="{x:Type vm:OverlayKeyframeVM}">
									<StackPanel>
										<TextBlock Text="Letterbox" FontSize="11" Foreground="#FF6B7480" />
										<DockPanel Margin="0,0,0,6">
											<TextBox Text="{Binding Letterbox, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}" Width="44" DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" TextAlignment="Center" Padding="2" />
											<Slider Value="{Binding Letterbox}" Minimum="0" Maximum="1" SmallChange="0.01" VerticalAlignment="Center" />
										</DockPanel>
										<TextBlock Text="Black" FontSize="11" Foreground="#FF6B7480" />
										<DockPanel>
											<TextBox Text="{Binding FadeAlpha, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}" Width="44" DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" TextAlignment="Center" Padding="2" />
											<Slider Value="{Binding FadeAlpha}" Minimum="0" Maximum="1" SmallChange="0.01" VerticalAlignment="Center" />
										</DockPanel>
									</StackPanel>
								</DataTemplate>
							<DataTemplate DataType="{x:Type vm:AudioKeyframeVM}">
									<StackPanel>
										<TextBlock Text="Sound event" FontSize="11" Foreground="#FF6B7480" />
										<TextBox Text="{Binding SoundEvent}" Margin="0,0,0,6" />
										<TextBlock Text="Volume" FontSize="11" Foreground="#FF6B7480" />
										<DockPanel>
											<TextBox Text="{Binding Volume, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}" Width="44" DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" TextAlignment="Center" Padding="2" />
											<Slider Value="{Binding Volume}" Minimum="0" Maximum="2" SmallChange="0.05" VerticalAlignment="Center" />
										</DockPanel>
										<CheckBox Content="Loop" IsChecked="{Binding Loop}" Margin="0,6,0,0" />
									</StackPanel>
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:EntityVisibilityKeyframeVM}">
									<CheckBox Content="Visible" IsChecked="{Binding Visible}" />
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:AgentAnimationKeyframeVM}">
									<StackPanel>
										<TextBlock Text="Target role" FontSize="11" Foreground="#FF6B7480" />
										<TextBox Text="{Binding TargetRole}" Margin="0,0,0,6" />
										<TextBlock Text="Action name" FontSize="11" Foreground="#FF6B7480" />
										<TextBox Text="{Binding ActionName}" Margin="0,0,0,6" />
										<CheckBox Content="Loop" IsChecked="{Binding Loop}" />
									</StackPanel>
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:SubtitleKeyframeVM}">
									<StackPanel>
										<TextBlock Text="Text" FontSize="11" Foreground="#FF6B7480" />
										<TextBox Text="{Binding Text}" Margin="0,0,0,6" AcceptsReturn="True" MinLines="2" />
										<Grid Margin="0,0,0,6">
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<StackPanel Grid.Column="0" Margin="0,0,4,0">
												<TextBlock Text="Duration (s)" FontSize="11" Foreground="#FF6B7480" />
												<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding Duration}" />
											</StackPanel>
											<StackPanel Grid.Column="1" Margin="4,0,0,0">
												<TextBlock Text="Fade (s)" FontSize="11" Foreground="#FF6B7480" />
												<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding FadeSec}" />
											</StackPanel>
										</Grid>
										<Grid Margin="0,0,0,6">
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<StackPanel Grid.Column="0" Margin="0,0,4,0">
												<TextBlock Text="Font size" FontSize="11" Foreground="#FF6B7480" />
												<widgets:NumericUpDownBox Style="{StaticResource InlineNumericUpDownStyle}" Value="{Binding FontSize}" />
											</StackPanel>
										<StackPanel Grid.Column="1" Margin="4,0,0,0">
											<TextBlock Text="Color" FontSize="11" Foreground="#FF6B7480" />
											<widgets:ColorPickerBox Text="{Binding FontColor}" FontSize="11" Height="24" VerticalAlignment="Center" />
										</StackPanel>
										</Grid>
									<TextBlock Text="Font" FontSize="11" Foreground="#FF6B7480" Margin="0,0,0,2" />
									<ComboBox FontSize="11" ItemsSource="{Binding FontOptions}" SelectedItem="{Binding Font}" Margin="0,0,0,6" />
									<Grid Margin="0,0,0,6">
										<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0" Margin="0,0,4,0">
											<TextBlock Text="Horizontal" FontSize="11" Foreground="#FF6B7480" />
											<ComboBox FontSize="11" ItemsSource="{Binding HPositionOptions}" SelectedItem="{Binding HPosition}" />
										</StackPanel>
											<StackPanel Grid.Column="1" Margin="4,0,0,0">
												<TextBlock Text="Vertical" FontSize="11" Foreground="#FF6B7480" />
												<ComboBox FontSize="11" ItemsSource="{Binding VPositionOptions}" SelectedItem="{Binding VPosition}" />
											</StackPanel>
										</Grid>
									</StackPanel>
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:LookAtKeyframeVM}">
									<StackPanel>
										<TextBlock Text="Target role" FontSize="11" Foreground="#FF6B7480" />
										<TextBox Text="{Binding TargetRole}" Margin="0,0,0,6" />
										<CheckBox Content="Use explicit position" IsChecked="{Binding UsePosition}" />
									</StackPanel>
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:EventKeyframeVM}">
									<StackPanel>
										<Button Content="Edit Actions" Height="28" Margin="0,0,0,4" Padding="8,0" Command="{Binding EditActionsCommand}" />
										<TextBlock FontSize="11" Foreground="#FF6B7480" Text="{Binding ActionCount, StringFormat='{}{0} action(s)'}" />
									</StackPanel>
								</DataTemplate>
								<DataTemplate DataType="{x:Type vm:GenericKeyframeVM}">
									<TextBlock Text="No inline editor for this type." FontSize="12" Foreground="#FF8A929C" />
								</DataTemplate>
							</ContentControl.Resources>
						</ContentControl>

						<Button Content="Delete" Height="30" Width="80" Margin="0,10,0,0" Padding="0" VerticalContentAlignment="Center" Command="{Binding DeleteGenericKeyframeCommand}" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- Settings -->
		<Border Grid.Row="3" BorderBrush="#FFBFC6CF" BorderThickness="1" Padding="10" CornerRadius="4">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0" />
				<TextBlock Text="Duration (s)" VerticalAlignment="Center" Margin="0,0,4,0" />
				<TextBox Width="58" Margin="0,0,4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="2"
						 Text="{Binding DurationSec, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = auto (derived from keyframes)" />
				<TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#FF6B7480" FontSize="11"
						   Text="{Binding EffectiveDuration, StringFormat='effective: {0:F1}s'}" />
			<CheckBox Content="Skippable" IsChecked="{Binding IsSkippable}" Margin="0,0,16,0" VerticalAlignment="Center" />
				<TextBlock Text="Main agent" VerticalAlignment="Center" Margin="0,0,4,0" />
				<ComboBox Width="120" VerticalContentAlignment="Center" ItemsSource="{Binding AgentBehaviorOptions}" SelectedItem="{Binding AgentBehavior}" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
